/* Download Manager - Ultra Estetik Obsidian Neon QSS Teması */

QWidget {
    background-color: #0f1117;
    color: #e2e8f0;
    font-family: "Segoe UI Variable Display", "Segoe UI", -apple-system, sans-serif;
    font-size: 13px;
    selection-background-color: #4f46e5;
    selection-color: #ffffff;
}

QMainWindow {
    background-color: #0c0e14;
}

/* Üst Menü Çubuğu (MenuBar) */
QMenuBar {
    background-color: #0f1117;
    color: #94a3b8;
    padding: 2px 8px;
    border-bottom: 1px solid #1a202c;
    font-size: 12px;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #1e2433;
    color: #f8fafc;
}

QMenu {
    background-color: #141824;
    color: #e2e8f0;
    border: 1px solid #28334a;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 20px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #2b354f;
    color: #ffffff;
}

/* Araç Çubuğu (ToolBar) */
QToolBar {
    background-color: #0f1117;
    border-bottom: 1px solid #1c2230;
    padding: 8px 12px;
    spacing: 10px;
}

/* Arama Kutusu (Search Bar) */
QLineEdit#searchBar {
    background-color: #161a24;
    border: 1px solid #232b3d;
    border-radius: 16px;
    color: #f1f5f9;
    padding: 6px 14px;
    font-size: 12px;
    min-width: 220px;
}

QLineEdit#searchBar:focus {
    border: 1px solid #6366f1;
    background-color: #1a202e;
}

/* '+ Add URL' Mor-Mavi Hap Butonu */
QPushButton#addUrlBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #3b82f6, stop:1 #9333ea);
    color: #ffffff;
    font-weight: bold;
    font-size: 13px;
    border-radius: 16px;
    padding: 7px 18px;
    border: 1px solid #818cf8;
}

QPushButton#addUrlBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #2563eb, stop:1 #7c3aed);
    border: 1px solid #a5b4fc;
}

QPushButton#addUrlBtn:pressed {
    background: #1d4ed8;
}

/* Araç Çubuğu Düz Eylem Butonları */
QPushButton#toolActionBtn {
    background: transparent;
    color: #94a3b8;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 500;
}

QPushButton#toolActionBtn:hover {
    background-color: #181d2a;
    color: #f1f5f9;
    border: 1px solid #262e42;
}

QPushButton#toolActionBtn:pressed {
    background-color: #21293a;
}

/* 🗑️ Delete Butonu — Add URL yanında, kırmızı vurgu */
QPushButton#toolDeleteBtn {
    background: transparent;
    color: #f87171;
    border: 1px solid #3f2020;
    border-radius: 8px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#toolDeleteBtn:hover {
    background-color: #2d1515;
    color: #fca5a5;
    border: 1px solid #7f1d1d;
}

QPushButton#toolDeleteBtn:pressed {
    background-color: #450a0a;
    border-color: #ef4444;
}

/* Sol Kategori Ağacı (QTreeWidget / QListWidget) */
QTreeWidget#sidebarTree, QListWidget#sidebarTree {
    background-color: #0d0f15;
    border: none;
    border-right: 1px solid #1a202d;
    padding: 8px 6px;
    color: #94a3b8;
    font-size: 13px;
    outline: none;
}

QTreeWidget#sidebarTree::item {
    padding: 6px 8px;
    border-radius: 6px;
    margin: 2px 0px;
}

QTreeWidget#sidebarTree::item:hover {
    background-color: #161b26;
    color: #f8fafc;
}

QTreeWidget#sidebarTree::item:selected {
    background-color: #1c2233;
    color: #38bdf8;
    font-weight: bold;
}

/* Ana İndirme Tablosu (QTableWidget) */
QTableWidget#downloadsTable {
    background-color: #11141d;
    alternate-background-color: #131722;
    gridline-color: transparent;
    border: none;
    color: #f1f5f9;
    font-size: 13px;
    outline: none;
}

QTableWidget#downloadsTable::item {
    padding: 8px 10px;
    border-bottom: 1px solid #1a202d;
}

QTableWidget#downloadsTable::item:selected {
    background-color: #1e2438;
    color: #ffffff;
}

QTableWidget#downloadsTable::item:hover {
    background-color: #171c2a;
}

/* Tablo Başlıkları (QHeaderView) */
QHeaderView::section {
    background-color: #0f121a;
    color: #64748b;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    border: none;
    border-bottom: 1px solid #1f2738;
    padding: 8px 10px;
}

QHeaderView::section:hover {
    color: #94a3b8;
}

/* Onay Kutusu (QCheckBox) */
QCheckBox {
    spacing: 6px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid #334155;
    background-color: #161a24;
}

QCheckBox::indicator:hover {
    border-color: #6366f1;
}

QCheckBox::indicator:checked {
    background-color: #6366f1;
    border-color: #818cf8;
    image: url("icons/check.png");
}

/* Sayı Seçiciler (QSpinBox) */
QSpinBox {
    background-color: #161a24;
    border: 1px solid #232b3d;
    border-radius: 4px;
    color: #f1f5f9;
    padding: 4px 44px 4px 10px;
    font-size: 13px;
    min-height: 28px;
}

QSpinBox:focus {
    border: 1px solid #6366f1;
    background-color: #1a202e;
}

QSpinBox:disabled {
    background-color: #13161f;
    color: #555e70;
    border-color: #1d2230;
}

/* Kaydırma Çubuğu (QScrollBar) */
QScrollBar:vertical {
    background-color: #0d0f15;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #273042;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background-color: #3b465e;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* Alt Durum Paneli (QStatusBar) */
QStatusBar {
    background-color: #0c0e14;
    border-top: 1px solid #1a202d;
    color: #64748b;
    font-size: 12px;
}

/* Sekmeler (QTabWidget) */
QTabWidget::pane {
    border: none;
    background-color: #10131d;
    border-radius: 8px;
}

QTabBar::tab {
    background: transparent;
    color: #64748b;
    padding: 8px 16px;
    font-weight: 600;
    font-size: 12px;
    border-bottom: 2px solid transparent;
}

QTabBar::tab:hover {
    color: #cbd5e1;
}

QTabBar::tab:selected {
    color: #f8fafc;
    border-bottom: 2px solid #818cf8;
}

/* Download Manager - Modern Cyber-Slate QSS Theme */

QWidget {
    background-color: #0b0f19;
    color: #cbd5e1;
    font-family: "Inter", "Segoe UI", -apple-system, sans-serif;
    font-size: 12px;
    selection-background-color: #0284c7;
    selection-color: #ffffff;
}

QMainWindow {
    background-color: #070a11;
}

/* ==================== Top Menu Bar ==================== */
QMenuBar {
    background-color: #090d16;
    color: #94a3b8;
    padding: 3px 8px;
    border-bottom: 1px solid #1e293b;
    font-size: 12px;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #1e293b;
    color: #f1f5f9;
}

QMenu {
    background-color: #0d131f;
    color: #cbd5e1;
    border: 1px solid #1e293b;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 20px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #172237;
    color: #38bdf8;
}

QMenu::separator {
    height: 1px;
    background-color: #1e293b;
    margin: 4px 6px;
}

/* ==================== Action Toolbar ==================== */
QToolBar {
    background-color: #0f1523;
    border-bottom: 1px solid #1e293b;
    padding: 6px 12px;
    spacing: 8px;
}

QWidget#logoWidget,
QWidget#toolbarSpacer {
    background: transparent;
    border: none;
}

/* + Add URL Primary Accent Button */
QPushButton#addUrlBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #2563eb, stop:0.5 #0284c7, stop:1 #06b6d4);
    color: #ffffff;
    font-weight: 600;
    font-size: 12px;
    border-radius: 8px;
    padding: 7px 16px;
    border: 1px solid rgba(56, 189, 248, 0.4);
}

QPushButton#addUrlBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1d4ed8, stop:0.5 #0284c7, stop:1 #0891b2);
    border: 1px solid #38bdf8;
}

QPushButton#addUrlBtn:pressed {
    background: #1e40af;
}

/* Delete Button */
QPushButton#toolDeleteBtn {
    background-color: rgba(30, 41, 59, 0.6);
    color: #cbd5e1;
    border: 1px solid rgba(51, 65, 85, 0.7);
    border-radius: 8px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 500;
}

QPushButton#toolDeleteBtn:hover {
    background-color: rgba(239, 68, 68, 0.15);
    color: #f87171;
    border: 1px solid rgba(239, 68, 68, 0.4);
}

QPushButton#toolDeleteBtn:pressed {
    background-color: rgba(239, 68, 68, 0.25);
    border-color: #ef4444;
}

/* Secondary Action Buttons (Capture, Start Queue, Stop Queue, Stop All, Settings) */
QPushButton#toolActionBtn,
QPushButton#toolCaptureBtn,
QPushButton#toolQueueStartBtn,
QPushButton#toolQueueStopBtn,
QPushButton#toolStopAllBtn,
QPushButton#toolSettingsBtn {
    background-color: rgba(30, 41, 59, 0.5);
    color: #cbd5e1;
    border: 1px solid rgba(51, 65, 85, 0.6);
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 500;
}

QPushButton#toolActionBtn:hover,
QPushButton#toolCaptureBtn:hover,
QPushButton#toolQueueStartBtn:hover,
QPushButton#toolQueueStopBtn:hover,
QPushButton#toolStopAllBtn:hover,
QPushButton#toolSettingsBtn:hover {
    background-color: #172237;
    color: #f1f5f9;
    border: 1px solid #38bdf8;
}

QPushButton#toolActionBtn:pressed,
QPushButton#toolCaptureBtn:pressed,
QPushButton#toolQueueStartBtn:pressed,
QPushButton#toolQueueStopBtn:pressed,
QPushButton#toolStopAllBtn:pressed,
QPushButton#toolSettingsBtn:pressed {
    background-color: #1e293b;
}

/* Live Search Bar */
QLineEdit#searchBar {
    background-color: #141b2a;
    border: 1px solid #1e293b;
    border-radius: 8px;
    color: #f1f5f9;
    padding: 6px 10px 6px 8px;
    font-size: 12px;
    min-width: 240px;
}

QLineEdit#searchBar:focus {
    border: 1px solid #38bdf8;
    background-color: #141b2a;
}

/* ==================== Left Sidebar ==================== */
QTreeWidget#sidebarTree {
    background-color: #0d1320;
    border: none;
    border-right: 1px solid #1e293b;
    padding: 8px 6px;
    color: #94a3b8;
    font-size: 12px;
    outline: none;
    show-decoration-selected: 0;
}

QTreeWidget#sidebarTree::branch {
    background: transparent;
    border: none;
}

QTreeWidget#sidebarTree::item {
    padding: 7px 10px;
    border-radius: 8px;
    margin: 1px 4px;
}

QTreeWidget#sidebarTree::item:hover {
    background-color: rgba(30, 41, 59, 0.5);
    color: #f1f5f9;
}

QTreeWidget#sidebarTree::item:selected {
    background-color: rgba(37, 99, 235, 0.2);
    border: 1px solid rgba(56, 189, 248, 0.3);
    color: #38bdf8;
    font-weight: 600;
}

/* Storage Disk Usage Card in Sidebar */
QFrame#diskCard {
    background-color: #0a0f1a;
    border-top: 1px solid #1e293b;
    padding: 10px 14px;
}

/* ==================== Main Downloads Table ==================== */
QTableWidget#downloadsTable {
    background-color: #0b0f19;
    alternate-background-color: #0b0f19;
    gridline-color: transparent;
    border: none;
    color: #f1f5f9;
    font-size: 12px;
    outline: none;
}

QTableWidget#downloadsTable QWidget {
    background: transparent;
}

QTableWidget#downloadsTable QLabel {
    background: transparent;
}

QTableWidget#downloadsTable::item {
    padding: 6px 10px;
    border-bottom: 1px solid rgba(30, 41, 59, 0.4);
}

QTableWidget#downloadsTable::item:selected {
    background-color: rgba(30, 41, 59, 0.55);
    color: #ffffff;
}

QTableWidget#downloadsTable::item:hover {
    background-color: rgba(30, 41, 59, 0.3);
}

/* Table Header (QHeaderView) */
QHeaderView::section {
    background-color: #111726;
    color: #94a3b8;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    border: none;
    border-bottom: 1px solid #1e293b;
    padding: 8px 10px;
}

QHeaderView::section:hover {
    color: #f1f5f9;
    background-color: #172237;
}

/* Checkbox */
QCheckBox {
    spacing: 6px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid #334155;
    background-color: #0f172a;
}

QCheckBox::indicator:hover {
    border-color: #38bdf8;
}

QCheckBox::indicator:checked {
    background-color: #0284c7;
    border-color: #38bdf8;
}

/* ==================== Scrollbars ==================== */
QScrollBar:vertical {
    background-color: #0b0f19;
    width: 6px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #1e293b;
    border-radius: 3px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #334155;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #0b0f19;
    height: 6px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #1e293b;
    border-radius: 3px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #334155;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* ==================== Bottom Status Bar ==================== */
QStatusBar {
    background-color: #090d16;
    border-top: 1px solid #1e293b;
    color: #94a3b8;
    font-size: 11px;
    padding: 2px 8px;
}

/* ==================== Dialogs & Inputs ==================== */
QDialog {
    background-color: #0b0f19;
    color: #f1f5f9;
}

QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #141b2a;
    border: 1px solid #1e293b;
    border-radius: 6px;
    color: #f1f5f9;
    padding: 6px 10px;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #38bdf8;
}

QSpinBox {
    background-color: #141b2a;
    border: 1px solid #1e293b;
    border-radius: 6px;
    color: #f1f5f9;
    padding: 4px 8px;
}

QSpinBox:focus {
    border: 1px solid #38bdf8;
}

/* Tabs */
QTabWidget::pane {
    border: 1px solid #1e293b;
    background-color: #0d131f;
    border-radius: 8px;
}

QTabBar::tab {
    background: transparent;
    color: #94a3b8;
    padding: 8px 16px;
    font-weight: 500;
    font-size: 12px;
    border-bottom: 2px solid transparent;
}

QTabBar::tab:hover {
    color: #f1f5f9;
}

QTabBar::tab:selected {
    color: #38bdf8;
    border-bottom: 2px solid #38bdf8;
}

/* ==================== Status Bar ==================== */
QStatusBar {
    background-color: #070a11;
    min-height: 24px;
    border-top: 1px solid #1e293b;
}

QStatusBar::item {
    border: none;
}
